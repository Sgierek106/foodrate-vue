# Turso Cloud Database Configuration
# Get your database URL and auth token from https://turso.tech/
# After creating a database, run: turso db tokens create <your-database-name>
TURSO_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
